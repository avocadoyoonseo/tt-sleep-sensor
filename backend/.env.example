# Copy to .env and fill in real values. Never commit .env.

# Long random string for signing JWTs
JWT_SECRET=jalen_awesome_key_tough

# OpenAI API key (sk-...)
OPENAI_API_KEY=sk-...

# Port the backend listens on
PORT=3001

# Secret the ESP32 sends in X-Device-Key header to authenticate data uploads.
# Set the same value in firmware/secrets.h as DEVICE_INGEST_KEY.
DEVICE_INGEST_KEY=local-dev-key
